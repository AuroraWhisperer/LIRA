# LIRA · 组件、进程与跨端连接
# 渲染: d2 --pad 24 components.d2 components.svg
# PNG: 用已有 Playwright Chromium 加载生成的 SVG，viewport 取根 viewBox 宽高，白底截图。
# D2 0.7.1 内置 PNG 驱动下载已失效；SVG 不依赖该驱动。
# 精确注册表通过节点链接访问；图中不重复维护端点、通道、字段或表数量。
direction: down

renderer: {
  label: "Electron renderer\nAdmin · 播放助手"
  link: ../frontend/pages.md
  style.fill: "#fef9e7"
}
bridge: {label: "Renderer preload · contextBridge\n受限 IPC 交给 main 校验来源"; link: ../desktop/preload.md}
desktop: {
  label: "Electron main · 同进程内嵌本地模块化单体"
  style.fill: "#eaf2f8"
  main: {label: "主进程远端控制器\n设备会话 · SSE / pull / history 恢复"; link: ../desktop/main.md}
  backend: {
    label: "本地 Node HTTP 运行时 · 环回监听"
    style.fill: "#f8f9f9"
    transport: {label: "本地 HTTP / WebSocket\n管理凭据与展示 scope 分离"; link: ../backend/server-core.md}
    bili: {label: "本地 Bilibili 输入\n弹幕 · 点歌 · SC · 用户信息 · 互动"; link: ../backend/bilibili/danmaku.md}
    local: {label: "本地领域服务\n音乐 / 队列 / 互动 / 加班机"; link: ../backend/music/services.md}
    projection: {label: "本地礼物投影与幂等消费\n无本地原始礼物检测器"; link: ../backend/bilibili/gift.md}
    store: {label: "客户端 SQLite\n本地业务数据 · 按来源隔离的礼物投影"; shape: cylinder; link: ../backend/storage.md}
  }
}
server: {
  label: "LIRA Server · 独立服务器边界"
  style.fill: "#e8f8f5"
  device: {label: "Device API / SSE\n认证后的主播 scope"}
  domains: {label: "权威礼物检测与账本\n云端签到 / 抽签及其他机器人"}
  store: {label: "服务器持久化\n主播私有状态 / 全局共享目录"; shape: cylinder}
}
obs: {label: "OBS / 本地展示页\n用途与入口见页面清单"; link: ../frontend/pages.md; style.fill: "#fef9e7"}
bilibili: {label: "Bilibili\n直播 HTTP / WebSocket"; style.fill: "#f4ecf7"}

renderer -> bridge: "受限桥方法"
bridge -> desktop.main: "main handler"
desktop.main -> server.device: "Device API 请求 / 建立 SSE"
server.device -> desktop.main: "SSE 事件 / pull 与 history 响应"
server.device <-> server.domains: "主播范围内的调用与事件"
server.domains -> server.store: "权威状态持久化"
desktop.main -> desktop.backend.projection: "当前来源 / 连续 cursor / 授权代次"
desktop.backend.projection -> desktop.backend.store: "事务写入投影与同步状态"
desktop.backend.projection -> desktop.backend.local: "符合资格的 live final 消费"
desktop.backend.store -> desktop.backend.transport: "查询与状态投影"
desktop.backend.local -> desktop.backend.transport: "快照与增量广播"
renderer <-> desktop.backend.transport: "受保护的本地 HTTP / WS"
desktop.backend.transport -> obs: "本 scope 的页面 / HTTP / WS"
bilibili -> desktop.backend.bili: "本地弹幕输入（仍运行）"
desktop.backend.bili -> desktop.backend.local: "点歌 / SC / 本地互动"
desktop.backend.local -> desktop.backend.store: "本地业务写入"
bilibili <-> server.domains: "服务器直播输入 / 云端机器人回复"
