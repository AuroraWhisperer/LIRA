{
  "name": "lira",
  "version": "4.0.4",
  "private": true,
  "license": "UNLICENSED",
  "description": "LIRA - Live Interactive Request Assistant",
  "author": "Aurora",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "node src/server.js",
    "desktop": "electron .",
    "desktop:tunnel": "set LIRA_LICENSE_API_BASE=http://127.0.0.1:13000&& electron .",
    "check": "node scripts/check-js.js",
    "test": "node --experimental-vm-modules --test --test-concurrency=6",
    "test:admin": "node --experimental-vm-modules --test --test-concurrency=4 test/admin-page-composition.test.js test/frontend-admin-shell.test.js test/frontend-admin-ai.test.js",
    "verify:docs": "node --test test/governance-docs.test.js",
    "verify:architecture": "node --experimental-vm-modules --test test/module-boundaries.test.js test/esm-module-boundaries.test.js",
    "verify:quick": "npm run verify:docs && npm run check && npm run verify:architecture",
    "verify": "npm run verify:quick && npm test",
    "refresh:gifts": "node scripts/refresh-bilibili-gift-sale.js",
    "sync:backpack-gifts": "node scripts/sync-bilibili-backpack-gifts.js",
    "diagnose:wesing": "node scripts/inspect-wesing-playback.js",
    "make:icon": "node scripts/create-icon.js",
    "dist:win": "npm run make:icon && electron-builder --win nsis --x64",
    "dist:win:local": "npm run make:icon && set ELECTRON_SKIP_BINARY_DOWNLOAD=1 && electron-builder --win nsis --x64 --config.electronDist=node_modules/electron/dist",
    "release:win": "node scripts/publish-release.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@clamber_l/crypto": "0.1.12",
    "@jixun/qmweb-sign": "2.0.3",
    "electron-updater": "^6.8.4",
    "playwright": "^1.62.1",
    "qrc-decoder": "1.0.2"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.11.1"
  },
  "build": {
    "appId": "com.aurorawhisperer.lira",
    "productName": "LIRA",
    "artifactName": "lira-setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "!public/img/admin/queue/*.png",
      "!public/img/admin/gifts/bilibili-guard-*.png",
      "!public/img/admin/gifts/gift-section-icon.png",
      "!public/img/shared/live-refresh-icon.png",
      "!public/img/admin/nav-icons/*.png",
      "!public/img/overlays/opening/avatar.png",
      "!public/img/overlays/song-board-style-3/*.png",
      "!public/img/overlays/song-board-style-4/*.png",
      "!public/img/overlays/song-board-style-5/*.png",
      "!public/img/overlays/song-board-style-6/*.png",
      "!public/img/playback/player-turntable-chassis.png",
      "!public/img/playback/qqmusic-icon.png",
      "!public/img/usage-guide/*.png",
      "package.json"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "lira-setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LIRA",
      "uninstallDisplayName": "LIRA",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AuroraWhisperer",
        "repo": "LIRA",
        "releaseType": "release"
      }
    ]
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  }
}
