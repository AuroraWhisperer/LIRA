{
  "name": "lira",
  "version": "3.4.12",
  "private": true,
  "license": "UNLICENSED",
  "description": "LIRA - Live Interactive Request Assistant",
  "author": "Aurora",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "node src/server.js",
    "desktop": "electron .",
    "check": "node scripts/check-js.js",
    "test": "node --experimental-vm-modules --test --test-concurrency=4",
    "diagnose:wesing": "node scripts/inspect-wesing-playback.js",
    "make:icon": "node scripts/create-icon.js",
    "dist:win": "npm run make:icon && electron-builder --win nsis --x64",
    "dist:win:local": "npm run make:icon && set ELECTRON_SKIP_BINARY_DOWNLOAD=1 && electron-builder --win nsis --x64 --config.electronDist=node_modules/electron/dist",
    "release:win": "node scripts/publish-release.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@jixun/qmweb-sign": "2.0.3",
    "electron-updater": "^6.8.4",
    "qrc-decoder": "1.0.2"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.11.1"
  },
  "build": {
    "appId": "com.aurorawhisperer.lira",
    "productName": "LIRA",
    "artifactName": "lira-setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "lira-setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LIRA",
      "uninstallDisplayName": "LIRA",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AuroraWhisperer",
        "repo": "LIRA",
        "releaseType": "release"
      }
    ]
  }
}
